filters:
  and:
    - file.ext == "md"
    - file.hasProperty("status")
    - "!file.path.startsWith('_templates/')"
    - "!file.path.startsWith('_inbox/')"
    - "!file.path.startsWith('_projeto/')"
views:
  - type: table
    name: Pipeline
    filters:
      and:
        - status != "vazio"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - tipo
      - status
      - ultima_revisao
    sort:
      - property: ultima_revisao
        direction: ASC
  - type: table
    name: Sem fonte
    filters:
      and:
        - status == "consolidado"
        - fontes.isEmpty()
        - lacunas.isEmpty()
    order:
      - file.name
      - tipo
      - status
      - fontes
      - lacunas
  - type: table
    name: Órgãos isolados
    filters:
      and:
        - status == "consolidado"
        - file.links.isEmpty()
    order:
      - file.name
      - tipo
      - status
  - type: table
    name: Regeneração
    filters:
      and:
        - status == "consolidado"
    order:
      - file.name
      - tipo
      - ultima_revisao
    sort:
      - property: ultima_revisao
        direction: ASC
    limit: 5
  - type: table
    name: Pauta de leitura
    filters:
      and:
        - "!lacunas.isEmpty()"
    order:
      - file.name
      - tipo
      - lacunas
  - type: table
    name: Léxico pessoal
    filters:
      and:
        - tipo == "palavra"
    order:
      - file.name
      - termos_originais
      - status
      - ultima_revisao
